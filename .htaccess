# ============================================================================
#  Meine Futterkiste – Server-Einstellungen für Apache (STRATO)
# ============================================================================

AddDefaultCharset UTF-8
DirectoryIndex index.html

# Lokale Schriften und Video mit korrektem Typ ausliefern
AddType font/woff2 .woff2
AddType video/mp4 .mp4

# ── Eine einzige Adresse für Google: https://meine-futterkiste.de ─────────
# HTTPS erzwingt STRATO bereits selbst, hier wird nur www. auf die Adresse
# ohne www umgeleitet (passend zu canonical und sitemap.xml).
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_HOST} ^www\.meine-futterkiste\.de$ [NC]
    RewriteRule ^(.*)$ https://meine-futterkiste.de/$1 [R=301,L]

    # Adressen der alten WordPress-Seite, die Google noch kennt, auf die Startseite
    RewriteRule ^(wp-content|wp-includes|wp-admin)/ - [G,L]
    RewriteCond %{QUERY_STRING} (^|&)p=[0-9]+ [OR]
    RewriteCond %{QUERY_STRING} (^|&)page_id=[0-9]+
    RewriteRule ^$ /? [R=301,L]

    # Unterseiten der alten Website (WordPress und Baukasten davor), die Google
    # noch als Sitelinks zeigt: per 301 auf den passenden Abschnitt der neuen Seite
    RewriteRule ^(home/)?impressum/?$ /impressum.html [R=301,L]
    RewriteRule ^(home/)?datenschutz/?$ /datenschutz.html [R=301,L]
    RewriteRule ^beratung(/|\.html)?$ /#beratung [R=301,NE,L]
    RewriteRule ^(ernaehrung|zubehoer)(/|\.html)?$ /#sortiment [R=301,NE,L]
    RewriteRule ^(futter|hundefutter|katzenfutter|nagerfutter|spezialfutter|angebote)\.html$ /#sortiment [R=301,NE,L]
    RewriteRule ^rohfleisch\.html$ /#barf [R=301,NE,L]
    RewriteRule ^(so-finden-sie-uns|oeffnungszeiten)(/|\.html)?$ /#besuch [R=301,NE,L]
    RewriteRule ^kontakt(/|\.html)?$ /#kontakt [R=301,NE,L]
    RewriteRule ^wir-ueber-uns(/|\.html)?$ /#ueber-uns [R=301,NE,L]
    RewriteRule ^(start/home|start/news)/?$ / [R=301,L]
    RewriteRule ^sitemap\.html$ / [R=301,L]

    # Was es nicht mehr gibt (Bienenfutter, Lieferservice, Blog-Archive, alte
    # Bilder): 410 Gone, damit Google die Adressen schneller vergisst als bei 404
    RewriteRule ^(bienenfutter|lieferservice)(/|\.html)?$ - [G,L]
    RewriteRule ^(tag|category|author|[0-9]{4})/ - [G,L]
    RewriteRule ^(interessante-links|partner-links|apifonda|apiinvert)\.html$ - [G,L]
    RewriteRule ^(mediapool|designs)/ - [G,L]
</IfModule>

# ── Sicherheits-Header ─────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Einstellungen und GitHub-Ordner nie ausliefern ────────────────────────
# config.php enthält das Postfach-Passwort. Normalerweise führt der Server
# PHP aus und zeigt nichts an, das hier greift, falls PHP einmal ausfällt.
<FilesMatch "^(config\.php|\.git.*)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.github(/|$)

# ── Verzeichnisauflistung verhindern ───────────────────────────────────────
Options -Indexes

# ── Komprimierung ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ── Browser-Zwischenspeicher ───────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg        "access plus 1 year"
    ExpiresByType image/png         "access plus 1 year"
    ExpiresByType image/webp        "access plus 1 year"
    ExpiresByType image/svg+xml     "access plus 1 year"
    ExpiresByType font/woff2        "access plus 1 year"
    ExpiresByType video/mp4         "access plus 1 month"
    # CSS/JS ändern sich selten; bei neuer Version im Link ?v= hochzählen (z. B. lucide.min.js?v=0.460.0)
    ExpiresByType text/css          "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript   "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType text/html         "access plus 0 seconds"
    ExpiresByType application/json  "access plus 0 seconds"
</IfModule>
